{
  "name": "dsh-remote",
  "version": "0.6.24",
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./packages/plugin/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "description": "DSH 移动远程控制台: DSH 插件(内置网关自启停) + 独立网关 + Android App 一体",
  "updateNotes": "0.6.24：同步 App 与宽屏客户端的会话命名体验；未命名会话显示为“新会话”并保留短标识，创建会话时可选择指定工作区；补充空会话清理与相关回归验证。",
  "bin": "gateway.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "apk/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node gateway.js",
    "check": "node --check gateway.js && node --check gateway-stats.cjs && node --check packages/plugin/index.mjs && node --check public/app.js && node --check public/admin.js && node --check public/i18n.js && node --check public/theme.js && node --check public/sha256.js && node --check public/md.js && node --check public/desktop/desktop.js && node --check public/desktop/i18n.js && node --test tests/*.test.js",
    "test-windows-files": "node --test tests/windows-files.test.js tests/windows-gateway.test.js",
    "test-stats": "node --test tests/stats.test.js",
    "sync-app": "npx cap sync android",
    "build-app": "node scripts/build-app.mjs",
    "build-bin": "pkg .",
    "publish": "node scripts/publish.js && node scripts/sync-plugin.mjs",
    "publish-announcements": "bash scripts/sync-central-announcements.sh",
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "sync-standalone": "node scripts/sync-standalone.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@yao-pkg/pkg": "^6.22.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0"
  }
}
