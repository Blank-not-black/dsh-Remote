{
  "name": "dsh-remote",
  "version": "0.4.5",
  "private": true,
  "description": "DSH 移动远程控制台: DSH 插件(内置网关自启停) + 独立网关 + Android App 一体",
  "updateNotes": "手机更新走局域网直传: APK 随插件包分发, update.json 不再指向 GitHub",
  "bin": "gateway.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "apk/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node gateway.js",
    "check": "node --check gateway.js && node --check public/app.js",
    "sync-app": "npx cap sync android",
    "build-app": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "build-bin": "pkg .",
    "publish": "node scripts/publish.js && node scripts/sync-plugin.mjs",
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "sync-standalone": "node scripts/sync-standalone.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@yao-pkg/pkg": "^6.22.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0"
  }
}
