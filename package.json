{
  "name": "dsh-remote",
  "version": "0.5.0",
  "private": true,
  "description": "DSH 移动远程控制台: DSH 插件(内置网关自启停) + 独立网关 + Android App 一体",
  "updateNotes": "修复管理页二维码因 SVG 缺尺寸而渲染成白点; 右上角「网关」徽章可点击, 新标签页打开网关管理面板; 插件抽屉去掉彩色标题栏, 直接沉浸显示管理面板",
  "bin": "gateway.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "apk/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node gateway.js",
    "check": "node --check gateway.js && node --check public/app.js && node --check public/admin.js && node --check public/sha256.js",
    "sync-app": "npx cap sync android",
    "build-app": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "build-bin": "pkg .",
    "publish": "node scripts/publish.js && node scripts/sync-plugin.mjs",
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "sync-standalone": "node scripts/sync-standalone.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@yao-pkg/pkg": "^6.22.0"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0"
  }
}
