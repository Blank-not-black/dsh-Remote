{
  "name": "dsh-remote",
  "version": "0.3.0",
  "private": true,
  "description": "DSH 移动远程控制台: Web 版 + Capacitor App 封装",
  "updateNotes": "网关管理页 /admin: 状态监控、已连接设备、断开设备",
  "bin": "gateway.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "apk/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node gateway.js",
    "check": "node --check gateway.js && node --check public/app.js",
    "sync-app": "npx cap sync android",
    "build-app": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "build-bin": "pkg .",
    "publish": "node scripts/publish.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@yao-pkg/pkg": "^6.22.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0"
  }
}
