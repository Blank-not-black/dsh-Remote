# Copy to a private EnvironmentFile outside the repository; do not commit real keys.
# Keep disabled until the operator authorizes deployment and completes acceptance.
DSH_RELAY_SPONSOR_ENABLED=0
DSH_RELAY_SPONSOR_ADMIN_TOKEN=
DSH_RELAY_SPONSOR_MAX_USERS=79
DSH_RELAY_SPONSOR_ACCEPTING=1
# Optional Resend sending-only key scoped to the dedicated sender domain.
DSH_RELAY_SPONSOR_MAIL_KEY=
DSH_RELAY_SPONSOR_MAIL_FROM=
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
DSH_RELAY_TRUST_PROXY=0
DSH_RELAY_SPONSOR_QR=/opt/YOUR_SERVICE/donate.png
DSH_RELAY_SPONSOR_CONTACT_EMAIL=operator@example.com
