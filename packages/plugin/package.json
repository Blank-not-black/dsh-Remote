{
  "name": "dsh-remote-plugin",
  "version": "0.8.4",
  "description": "DSH Remote：DeepSeek Harness 手机远程控制台，查看会话、接审批、回答提问、继续对话与收发文件；内置网关，支持 Android 与手机/桌面 WebUI。社区第三方插件，作者 Blank-not-black。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "gateway.cjs",
    "gateway-stats.cjs",
    "public",
    "apk",
    "cordis.patch.yml",
    "*.md",
    "plugin-center.mjs",
    "plugin-transaction.mjs",
    "market.mjs",
    "insights.mjs",
    "approval-summary.mjs",
    "teams.mjs",
    "task-board.mjs",
    "peak-reminders.mjs",
    "skills.mjs",
    "doctor-skill.mjs",
    "doctor-target.mjs",
    "file-delivery.mjs",
    "skills",
    "session-file.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "bundle",
    "remote-control",
    "mobile",
    "android",
    "webui",
    "remote-approvals",
    "file-transfer",
    "self-hosted"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Blank-not-black/dsh-Remote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blank-not-black/dsh-Remote.git",
    "directory": "packages/plugin"
  },
  "bugs": {
    "url": "https://github.com/Blank-not-black/dsh-Remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
