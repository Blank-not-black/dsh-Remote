{
  "name": "dsh-remote-plugin",
  "version": "0.4.0",
  "description": "DSH Remote 官方 bundle 插件：在 DSH Web 内挂载 /remote 移动远程控制台（会话、后台工作、审批、提问、子代理、goal 操控），零网关零令牌，同源复用 DSH /api 与事件流。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "public",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "mobile"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
